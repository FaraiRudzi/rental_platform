SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

DB_NAME=rental_platform
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Celery. CELERY_EAGER=True runs tasks inline (no Redis needed) for development.
CELERY_EAGER=True
REDIS_URL=redis://localhost:6379/0

RENTAL_CONFIRM_HOURS=48
RENTAL_PAYMENT_DEADLINE_HOURS=72
# both_paid (recommended) or confirmed
RENTAL_RELEASE_CONTACTS_WHEN=both_paid
RENTAL_SMS_FALLBACK_MINUTES=10
# True = a landlord must have uploaded verification documents before submitting a listing
REQUIRE_VERIFIED_LANDLORD=False

# SMS: log (prints to console) or http
# SMS is only used as a fallback for alerts (there is no SMS-code login any more)
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=RentalApp

# WhatsApp Business Cloud API
WHATSAPP_ENABLED=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# Firebase Cloud Messaging (Android push)
FCM_ENABLED=False
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=firebase-credentials.json

# HMAC secret your payment gateway uses to sign webhooks
PAYMENT_WEBHOOK_SECRET=change-me

# Email, used for "forgot password". The default prints the email in the backend window (fine for testing).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Sign in with Google / Facebook (leave blank to hide those buttons). See README, section 3f.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
